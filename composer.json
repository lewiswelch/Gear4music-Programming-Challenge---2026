{
    "name": "candidate/gear4music-inventory",
    "description": "Multi-language, multi-currency, per-country inventory indexing",
    "type": "library",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gear4music\\Inventory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gear4music\\Inventory\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true
    }
}
